# Application Configuration
APP_NAME="AI Cooking Companion API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Database Configuration (PostgreSQL)
POSTGRES_USER=chef_user
POSTGRES_PASSWORD=chef_password
POSTGRES_DB=chef_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chef_user:chef_password@127.0.0.1:5432/chef_db

# LLM Provider Configuration ('fake', 'gemini', or 'openai')
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
LLM_MAX_MESSAGE_LENGTH=1000
